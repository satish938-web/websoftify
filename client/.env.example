# Copy to .env (local) or set these in the Netlify/Vercel dashboard. All are optional.

# The site's real public address. Default: https://websoftify.com (NOT confirmed yet)
VITE_SITE_URL=

# Google Analytics 4 Measurement ID, looks like G-XXXXXXXXXX. Empty = no analytics.
VITE_GA_ID=

# Google Search Console "HTML tag" verification code (only the content="..." value).
# Not needed if the domain is verified through DNS instead.
VITE_GSC_VERIFICATION=
